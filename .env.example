# Secret-free example. Replace paths and policy values locally; never commit
# master-key bytes, private keys, certificates, capabilities, or runtime state.

# Standalone broker
BROKER_MASTER_KEY_FILE=/run/secrets/secret-broker-master-key
SECRET_BROKER_TLS_CERT=/etc/secret-broker/server-cert.pem
SECRET_BROKER_TLS_KEY=/run/secrets/secret-broker-server-key.pem
SECRET_BROKER_TLS_CA_CERT=/etc/secret-broker/client-ca.pem
SECRET_BROKER_BIND_ADDR=127.0.0.1:50052
BROKER_SLED_PATH=./runtime/broker.sled
BROKER_TRANSPARENCY_LOG=./runtime/transparency.jsonl
CRYPTO_ENGINE_SEALED_STORE_PATH=./runtime/pq-keys.db
CRYPTO_ENGINE_HSM_TYPE=software
SECRET_BROKER_REQUIRE_ATTESTATION=true
BROKER_REQUIRE_DISCHARGE_ATTESTATION=true
BROKER_DISCHARGE_PRINCIPAL_ALLOWLIST=spiffe://example.test/workload/broker-client
SECRET_BROKER_PCCS_URL=https://pccs.example.test/sgx/certification/v4/

# Typed client: enforced mode
SECRET_BROKER_ENDPOINT=https://127.0.0.1:50052
SECRET_BROKER_CLIENT_MODE=enforced
SECRET_BROKER_CLIENT_CERT=/etc/secret-broker/client-cert.pem
SECRET_BROKER_CLIENT_KEY=/run/secrets/secret-broker-client-key.pem
SECRET_BROKER_CLIENT_CA_CERT=/etc/secret-broker/server-ca.pem
SECRET_BROKER_CLIENT_SERVER_NAME=secret-broker.example.test
SECRET_BROKER_CLIENT_TIMEOUT_SECS=10
SECRET_BROKER_CLIENT_POLICY_FILE=/etc/secret-broker/measurement-policy.json
SECRET_BROKER_CLIENT_SUBJECTS=secret-broker.example.test

# Controlled loopback mTLS integration only:
# - set SECRET_BROKER_CLIENT_MODE=local
# - set both attestation requirements above to false
# - do not use either relaxation on a non-loopback broker bind
